---
/**
 * The one layout every page uses. It sets the world on <html>, loads tokens
 * and base styles, and wraps the page in the shared top bar and footer.
 *
 *   <Base title="Lab" world="lab"> ... </Base>
 */
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { WORLDS, type World } from '../data/taxonomy';

interface Props {
  /** Page title. Omit on the home page. */
  title?: string;
  description?: string;
  world?: World;
  /** Keep the page out of search engines (style guide, 404). */
  noindex?: boolean;
  /** Picture shown when the page is shared. Defaults to the world's own card. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Set on posts, so shares and search results carry the date. */
  article?: { published: Date; modified?: Date; tags?: string[] };
  /** Extra structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  world = 'neutral',
  noindex = false,
  image,
  imageAlt,
  article,
  jsonLd,
} = Astro.props;

const origin = Astro.site ?? new URL(site.url);
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ML for chemistry, games with generative AI`;
const canonical = new URL(Astro.url.pathname, origin);

// Share image: the entry's own cover, cropped to 1200 × 630, or else the
// world's ready-made card in public/og/. (Vector covers are skipped: most
// sites that show link previews cannot draw SVG.)
const share =
  image && image.format !== 'svg'
    ? { src: (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, alt: imageAlt ?? title ?? site.name }
    : { src: `/og/${world}.png`, alt: `${site.name}: ${site.tagline}` };
const shareUrl = new URL(share.src, origin);
---

<!doctype html>
<html lang={site.locale} data-world={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={WORLDS[world].themeColor} />

    {/* How the page looks when shared (Open Graph, also read by X/Twitter, LinkedIn, WhatsApp). */}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Journal`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    {/* Fonts: the shared sans is always preloaded; a world's own display
        face is preloaded only on that world's pages. Everything is
        self-hosted with metrics-matched fallbacks, so text never jumps. */}
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-martian" />
    <Font cssVariable="--font-mona" preload={world === 'studio'} />
    <Font cssVariable="--font-brygada" preload={world === 'journal'} />

    {/* Runs before first paint. If the visitor allows motion, mark the page
        as waiting for its opening animation (see motion.css). If the
        animation code has not arrived in three seconds, stop waiting. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.motion = 'pending';
        setTimeout(() => {
          const root = document.documentElement;
          if (root.dataset.motion === 'pending') root.dataset.motion = 'off';
        }, 3000);
      }
    </script>

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
