---
/**
 * Home: the neutral hub. Intro, what is being built right now, then all the
 * work with filters. Each card is painted by its own world.
 */
import Base from '../layouts/Base.astro';
import CurrentlyBuilding from '../components/CurrentlyBuilding.astro';
import Intro from '../components/Intro.astro';
import WorkFeed from '../components/WorkFeed.astro';
import { countTags, getFeed } from '../lib/feed';

const items = await getFeed();
---

<Base>
  <Intro />
  <CurrentlyBuilding />
  <WorkFeed items={items} tags={countTags(items)} total={items.length} mode="inline" />
</Base>
