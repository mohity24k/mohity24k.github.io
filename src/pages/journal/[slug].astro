---
import { render } from 'astro:content';
import EntryPage from '../../components/EntryPage.astro';
import { getFeed, getPosts } from '../../lib/feed';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const item = (await getFeed()).find((i) => i.key === `posts/${entry.id}`)!;
const { Content } = await render(entry);
---

<EntryPage item={item} back={{ href: '/journal/', label: 'All Journal posts' }}>
  <Content />
</EntryPage>
