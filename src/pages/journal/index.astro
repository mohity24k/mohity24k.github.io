---
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getFeed } from '../../lib/feed';

const items = (await getFeed()).filter((item) => item.world === 'journal');
---

<Base title="Journal" world="journal" description="Posts and devlogs, about once a month.">
  <div class="wrap page">
    <h1>Journal</h1>
    <p class="lede">Posts and devlogs, about once a month.</p>
    <CardGrid items={items} heading="h2" />
  </div>
</Base>

<style>
  .page {
    padding-block-start: var(--space-3xl);
  }

  .lede {
    max-width: var(--measure);
    margin-block: var(--space-md) var(--space-2xl);
    color: var(--ink-soft);
    font-size: var(--step-1);
  }
</style>
