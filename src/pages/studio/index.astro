---
/**
 * Studio: games and AI art. Opens with the visual-novel dialogue, then what
 * is being made, then the gallery.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import StudioIntro from '../../components/StudioIntro.astro';
import { getFeed } from '../../lib/feed';

const PREVIEW = 6;

const projects = (await getFeed()).filter((item) => item.world === 'studio');
const pieces = (await getCollection('gallery')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allStandIns = pieces.length > 0 && pieces.every((piece) => piece.data.placeholder.length > 0);
---

<Base title="Studio" world="studio" description="Games and AI art: a visual novel in progress, and a gallery of generated pieces with the model and workflow behind each.">
  <StudioIntro />

  {
    projects.length > 0 && (
      <section class="wrap section">
        <h2>In the works</h2>
        <CardGrid items={projects} size={projects.length < 3 ? 'wide' : 'standard'} />
      </section>
    )
  }

  {
    pieces.length > 0 && (
      <section class="wrap section" id="gallery">
        <div class="section__head">
          <h2>Gallery</h2>
          <p>
            {allStandIns
              ? 'These three are stand-ins drawn by this site’s code. Generated pieces from the visual novel will replace them, each labelled AI-generated with its model and workflow.'
              : 'AI-generated images and short clips. Each one lists the model, the workflow and what it was made for.'}
          </p>
        </div>
        <Gallery pieces={pieces.slice(0, PREVIEW)} />
        {pieces.length > PREVIEW && (
          <p class="section__more">
            <a class="btn btn--quiet" href="/studio/gallery/">
              <span>All {pieces.length} pieces</span>
              <Icon name="arrow" />
            </a>
          </p>
        )}
        <Lightbox />
      </section>
    )
  }
</Base>

<style>
  .section {
    margin-block-start: var(--space-3xl);
    scroll-margin-top: var(--space-lg);
  }

  .section > h2,
  .section__head {
    margin-block-end: var(--space-lg);
  }

  .section__head p {
    max-width: var(--measure);
    margin-block-start: var(--space-sm);
    color: var(--ink-soft);
  }

  .section__more {
    margin-block-start: var(--space-md);
  }
</style>
