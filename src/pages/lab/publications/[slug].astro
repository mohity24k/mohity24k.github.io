---
/**
 * One publication: the reference, where to read it, a summary, an optional
 * abstract (the body of the .md file) and ready-to-copy citations.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Citation from '../../../components/Citation.astro';
import Icon from '../../../components/Icon.astro';
import Prose from '../../../components/Prose.astro';
import { TAGS } from '../../../data/taxonomy';
import { getItem } from '../../../lib/feed';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const item = (await getItem(`publications/${entry.id}`))!;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

// BibTeX, built only from the citation fields.
const surname = (data.authors[0] ?? 'anon').split(',')[0]!.toLowerCase().replace(/[^a-z]/g, '');
const firstWord = data.title.toLowerCase().split(/\W+/).find((w) => w.length > 3) ?? 'paper';
const bibtex = [
  `@article{${surname}${data.year}${firstWord},`,
  `  author  = {${data.authors.join(' and ')}},`,
  `  title   = {${data.title}},`,
  `  journal = {${data.venue}},`,
  `  year    = {${data.year}},`,
  data.volume && `  volume  = {${data.volume}},`,
  data.issue && `  number  = {${data.issue}},`,
  data.pages && `  pages   = {${data.pages}},`,
  data.doi && `  doi     = {${data.doi}},`,
  '}',
]
  .filter(Boolean)
  .join('\n');
---

<Base title={data.title} world="lab" description={data.summary}>
  <article class="wrap pub">
    <a class="back ui" href="/lab/#publications">
      <Icon name="back" />
      <span>Lab</span>
    </a>

    <h1>{data.title}</h1>
    <p class="pub__cite">
      <Citation entry={entry} />
    </p>

    {
      item.links.length > 0 && (
        <ul class="pub__actions">
          {item.links.map(({ label, href }) => (
            <li>
              {href ? (
                <a class="btn btn--big" href={href} target="_blank" rel="noopener">
                  <span>{label === 'DOI' ? 'Read the paper' : label}</span>
                  <Icon name="external" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              ) : (
                <span class="soon soon--big">
                  {label === 'DOI' ? 'DOI link' : label}
                  <span aria-hidden="true">·</span>
                  coming soon
                </span>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <section class="pub__section">
      <h2>{hasBody ? 'Abstract' : 'Summary'}</h2>
      {
        hasBody ? (
          <Prose>
            <Content />
          </Prose>
        ) : (
          <p class="pub__summary">{data.summary}</p>
        )
      }
      <ul class="pub__tags label">
        {data.tags.map((tag) => (
          <li>
            <a href={`/tags/${tag}/`}>{TAGS[tag]}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="pub__section">
      <h2>Cite this</h2>
      <pre class="pub__bibtex" tabindex="0" aria-label="BibTeX entry"><code>{bibtex}</code></pre>
    </section>
  </article>
</Base>

<style>
  .pub {
    padding-block-start: var(--space-xl);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    color: var(--ink-soft);
    font-weight: 550;
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .pub h1 {
    max-width: 24ch;
    margin-block-start: var(--space-md);
    font-size: var(--step-4);
  }

  .pub__cite {
    max-width: var(--measure);
    margin-block-start: var(--space-lg);
    color: var(--ink-soft);
  }

  .pub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .btn--big,
  .soon--big {
    min-height: 3.25rem;
    padding-inline: var(--space-lg);
  }

  .pub__section {
    max-width: var(--measure);
    margin-block-start: var(--space-2xl);
  }

  .pub__section h2 {
    margin-block-end: var(--space-md);
    font-size: var(--step-2);
  }

  .pub__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .pub__bibtex {
    overflow-x: auto;
    margin: 0;
    padding: var(--space-md);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--bg-raised);
    line-height: 1.6;
  }
</style>
