---
/**
 * Lab: projects, publications and certifications in AI, chemistry, pharma
 * and research.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import Citation from '../../components/Citation.astro';
import FilterChips from '../../components/FilterChips.astro';
import Icon from '../../components/Icon.astro';
import LabFigure from '../../components/LabFigure.astro';
import { certifications } from '../../data/about';
import { countTags, getFeed } from '../../lib/feed';

const lede = 'Machine learning, cheminformatics, pharma and research: what I have built and published.';

const items = (await getFeed()).filter((item) => item.world === 'lab');
const projects = items.filter((item) => item.collection === 'projects');
const publications = (await getCollection('publications')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const feedItem = (id: string) => items.find((item) => item.key === `publications/${id}`)!;
---

<Base title="Lab" world="lab" description={lede}>
  <header class="wrap head">
    <div>
      <h1>Lab</h1>
      <p class="head__lede">{lede}</p>
    </div>
    <div class="head__figure">
      <LabFigure seed="lab/index/1" />
    </div>
  </header>

  <div class="wrap" data-feed="inline">
    <FilterChips tags={countTags(items)} total={items.length} allHref="/lab/" label="Filter Lab work by interest" />

    {
      projects.length > 0 && (
        <section class="section" data-group>
          <h2>Projects</h2>
          <CardGrid items={projects} />
        </section>
      )
    }

    {
      publications.length > 0 && (
        <section class="section" data-group id="publications">
          <h2>Publications</h2>
          <ol class="refs">
            {publications.map((entry) => {
              const item = feedItem(entry.id);
              return (
                <li data-tags={item.tags.join(' ')}>
                  <p class="refs__cite">
                    <Citation entry={entry} link />
                  </p>
                  <p class="refs__summary">{entry.data.summary}</p>
                  <ul class="refs__links ui">
                    {item.links.map(({ label, href }) => (
                      <li>
                        {href ? (
                          <a href={href} target="_blank" rel="noopener">
                            <span>{label}</span>
                            <Icon name="external" size={14} />
                            <span class="sr-only">(opens in a new tab)</span>
                          </a>
                        ) : (
                          <span class="soon">
                            {label}
                            <span aria-hidden="true">·</span>
                            coming soon
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }
  </div>

  {
    certifications.length > 0 && (
      <section class="wrap section">
        <h2>Certifications</h2>
        <ul class="certs">
          {certifications.map((cert) => (
            <li>
              <span class="certs__title">{cert.url ? <a href={cert.url}>{cert.title}</a> : cert.title}</span>
              <span class="label">
                {cert.issuer} · {cert.date}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: end;
    gap: var(--space-xl) var(--space-3xl);
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .head__lede {
    max-width: 34ch;
    margin-block-start: var(--space-md);
    color: var(--ink-soft);
    font-size: var(--step-2);
    line-height: 1.35;
  }

  .section {
    margin-block-start: var(--space-3xl);
  }

  .section[hidden] {
    display: none;
  }

  .section h2 {
    margin-block-end: var(--space-lg);
  }

  /* Publications: a numbered reference list, as at the end of a paper. */
  .refs {
    display: grid;
    gap: var(--space-lg);
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: ref;
  }

  .refs > li {
    position: relative;
    padding: var(--space-lg) var(--space-lg) var(--space-lg) 4rem;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--bg-raised);
    counter-increment: ref;
  }

  .refs > li[hidden] {
    display: none;
  }

  .refs > li::before {
    content: '[' counter(ref) ']';
    position: absolute;
    inset-block-start: var(--space-lg);
    inset-inline-start: var(--space-lg);
    color: var(--accent-text);
    font-family: var(--font-data);
    font-stretch: var(--data-stretch);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.75;
  }

  .refs__summary {
    margin-block-start: var(--space-xs);
    color: var(--ink-soft);
    font-size: 0.95em;
  }

  .refs__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
  }

  .refs__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-weight: 600;
  }

  .certs {
    display: grid;
    gap: var(--space-sm);
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    padding-block: var(--space-sm);
    border-block-end: var(--border-w) solid var(--line);
  }

  .certs__title {
    font-weight: 600;
  }

  @media (max-width: 52rem) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      padding-block-start: var(--space-xl);
    }

    .head__figure {
      max-width: 22rem;
    }

    .refs > li {
      padding-inline-start: var(--space-lg);
      padding-block-start: 3.25rem;
    }
  }
</style>
