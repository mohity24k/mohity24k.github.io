---
import Base from '../../layouts/Base.astro';
import ScaffoldList from '../../components/ScaffoldList.astro';
import { scaffoldItems } from '../../lib/scaffold';

const items = (await scaffoldItems()).filter((i) => i.world === 'lab');
---

<Base title="Lab" world="lab">
  <div class="wrap page">
    <h1>Lab</h1>
    <p class="lede">AI, cheminformatics, pharma and research: projects and publications.</p>
    <ScaffoldList items={items} note="Scaffold view. Cards, tag filters, project pages and the publications list arrive in steps 2 and 3." />
  </div>
</Base>

<style>
  .page {
    padding-block-start: var(--space-3xl);
  }

  .lede {
    max-width: var(--measure);
    margin-block: var(--space-md) var(--space-2xl);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
</style>
