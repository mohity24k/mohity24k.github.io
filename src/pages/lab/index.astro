---
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getFeed } from '../../lib/feed';

const items = (await getFeed()).filter((item) => item.world === 'lab');
---

<Base title="Lab" world="lab" description="AI, cheminformatics, pharma and research: projects and publications.">
  <div class="wrap page">
    <h1>Lab</h1>
    <p class="lede">AI, cheminformatics, pharma and research: projects and publications.</p>
    <CardGrid items={items} heading="h2" />
  </div>
</Base>

<style>
  .page {
    padding-block-start: var(--space-3xl);
  }

  .lede {
    max-width: var(--measure);
    margin-block: var(--space-md) var(--space-2xl);
    color: var(--ink-soft);
    font-size: var(--step-1);
  }
</style>
