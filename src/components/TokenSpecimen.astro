---
/**
 * Shows one world's tokens at work: type voices, colours and controls.
 * Used on /styleguide/. It carries its own data-world, so four of these can
 * sit on one page, each in its own world.
 */
import Icon from './Icon.astro';
import type { World } from '../data/taxonomy';

interface Props {
  world: World;
}

const { world } = Astro.props;

const SAMPLES: Record<World, { name: string; used: string; display: string; body: string; label: string; faces: [string, string, string] }> = {
  neutral: {
    name: 'Neutral',
    used: 'Home and About',
    display: "Hi, I'm Mohit.",
    body: 'I build ML for chemistry & drug problems, and games with generative AI.',
    label: 'Selected work',
    faces: ['Schibsted Grotesk 750', 'Schibsted Grotesk 400', 'Schibsted Grotesk 600'],
  },
  lab: {
    name: 'Lab',
    used: 'AI, chemistry, pharma, research',
    display: 'Green Chemistry & Reaction Metrics Calculator',
    body: 'Pulls reactions out of PDFs, converts them to SMILES and scores them on PMI, atom economy, E-factor, EcoScale and GHS hazards.',
    label: '91.7% accuracy / F1 · 4,586 clips · −12.7% eval loss',
    faces: ['Schibsted Grotesk 650', 'Schibsted Grotesk 400', 'Martian Mono 450, 87.5% width'],
  },
  studio: {
    name: 'Studio',
    used: 'Games, AI art, XR',
    display: 'Visual novel, in progress',
    body: 'Its art and video are generated with ComfyUI and open-source image and video models.',
    label: 'In progress · Game Dev',
    faces: ['Mona Sans 800, 125% width', 'Schibsted Grotesk 400', 'Mona Sans 600, 112% width, caps'],
  },
  journal: {
    name: 'Journal',
    used: 'Posts and devlogs',
    display: 'Devlog #0: starting the visual novel',
    body: 'This journal is where I’ll write that work up, about once a month: what I tried, what worked, and what I’d do differently.',
    label: '15 November 2026 · devlog',
    faces: ['Brygada 1918 Italic 500', 'Brygada 1918 400', 'Brygada 1918 Italic 500'],
  },
};

const COLOURS = [
  'bg', 'bg-raised', 'bg-sunken', 'ink', 'ink-soft', 'ink-faint', 'line', 'line-strong',
  'accent', 'accent-ink', 'accent-text', 'accent-soft', 'accent-2', 'focus',
];

const s = SAMPLES[world];
---

<section class="specimen world-surface" data-world={world} aria-labelledby={`specimen-${world}`}>
  <div class="wrap specimen__grid">
    <header class="specimen__head">
      <h2 id={`specimen-${world}`} class="ui specimen__name">
        <code>data-world="{world}"</code>
      </h2>
      <p class="ui specimen__used">{s.name}: {s.used}</p>
    </header>

    <div class="specimen__type">
      <p class="specimen__display">{s.display}</p>
      <p class="specimen__body">{s.body}</p>
      <p class="label">{s.label}</p>

      <dl class="ui specimen__faces">
        <div><dt>Display</dt><dd>{s.faces[0]}</dd></div>
        <div><dt>Body</dt><dd>{s.faces[1]}</dd></div>
        <div><dt>Label</dt><dd>{s.faces[2]}</dd></div>
      </dl>
    </div>

    <div class="specimen__controls">
      <a class="btn" href="#main"><span>Primary</span><Icon name="arrow" /></a>
      <a class="btn btn--quiet" href="#main"><span>Quiet</span></a>
      <a href="#main">A text link</a>
      <span class="soon">Coming soon</span>
    </div>

    <ul class="specimen__colours ui" aria-label={`${s.name} colour tokens`}>
      {
        COLOURS.map((token) => (
          <li>
            <span class="chip" style={`background-color: var(--${token})`} />
            <code>--{token}</code>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .specimen {
    padding-block: var(--space-2xl);
    border-block-start: var(--border-w) solid var(--line);
  }

  .specimen__grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-xl) var(--grid-gap);
  }

  .specimen__head {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
  }

  .specimen__name {
    font-weight: 650;
    color: var(--ink);
  }

  .specimen__used {
    color: var(--ink-soft);
  }

  .specimen__display {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--display-weight);
    font-style: var(--display-style);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--display-tracking);
    line-height: var(--display-leading);
    text-wrap: balance;
  }

  .specimen__body {
    max-width: var(--measure);
    margin-block: var(--space-md) var(--space-sm);
  }

  .specimen__faces {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: var(--border-w) solid var(--line);
    color: var(--ink-soft);
  }

  .specimen__faces div {
    display: grid;
    grid-template-columns: 5rem 1fr;
  }

  .specimen__faces dd {
    margin: 0;
    color: var(--ink);
  }

  .specimen__controls {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .specimen__colours {
    grid-column: 2;
    grid-row: 2 / span 2;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    align-content: start;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-soft);
  }

  .specimen__colours li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .chip {
    width: 1.75rem;
    height: 1.75rem;
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-sm);
    flex: none;
  }

  @media (max-width: 52rem) {
    .specimen__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .specimen__colours {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
