---
/**
 * The "life" photo strip on the About page. Photos come from
 * src/assets/life/ and captions from src/data/about.ts. A photo that has
 * not been added yet is drawn as a stand-in tile in one of the worlds.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { lifePhotos, type LifePhoto } from '../data/about';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/life/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const byName = new Map(
  Object.entries(files).map(([path, mod]) => [path.split('/').pop()!.replace(/\.[^.]+$/, ''), mod.default]),
);

// Stand-in pictograms: 24px line icons in the same hand as the site's icon set.
const ICONS: Record<LifePhoto['standIn']['icon'], string> = {
  flask: 'M9 3.5h6M10 3.5V9l-4.8 9.2A1.6 1.6 0 0 0 6.6 20.5h10.8a1.6 1.6 0 0 0 1.4-2.3L14 9V3.5M7.6 15h8.8',
  chess: 'M7 20.5h10M8.5 20.5v-2.5l1-7.5H7.5V5h2v2h1.5V5h2v2h1.5V5h2v5.5h-2l1 7.5v2.5',
  wave: 'M3 9c2.2 0 2.2-2 4.5-2s2.3 2 4.5 2 2.2-2 4.5-2 2.3 2 4.5 2M3 14.5c2.2 0 2.2-2 4.5-2s2.3 2 4.5 2 2.2-2 4.5-2 2.3 2 4.5 2M3 20c2.2 0 2.2-2 4.5-2s2.3 2 4.5 2 2.2-2 4.5-2 2.3 2 4.5 2',
  book: 'M12 6.5C10 5 7 5 4 5.5v13c3-.5 6-.5 8 1 2-1.5 5-1.5 8-1v-13c-3-.5-6-.5-8 1zM12 6.5v13',
  compass: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM15.8 8.2l-2.3 5.3-5.3 2.3 2.3-5.3z',
};

const photos = lifePhotos.map((photo) => ({ ...photo, image: byName.get(photo.file) }));
---

{/* Focusable so the row can be scrolled with the arrow keys when it overflows. */}
<ul class="strip" tabindex="0" aria-label="Photos from away from the desk">
  {
    photos.map((photo) => (
      <li>
        <figure>
          {photo.image ? (
            <div class="strip__frame strip__photo">
              <Image src={photo.image} alt={photo.alt ?? photo.caption} widths={[320, 480, 640]} sizes="(min-width: 60rem) 15rem, 60vw" />
            </div>
          ) : (
            <div class="strip__frame strip__stand-in world-surface" data-world={photo.standIn.world} role="img" aria-label={`${photo.caption}: photo coming soon`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={ICONS[photo.standIn.icon]} />
              </svg>
            </div>
          )}
          <figcaption>
            <span>{photo.caption}</span>
            {!photo.image && <span class="soon">Photo coming soon</span>}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  /* A row of prints. It scrolls sideways when the screen is too narrow for
     all of them, snapping to each print. */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(11.5rem, 1fr);
    gap: var(--grid-gap);
    overflow-x: auto;
    margin: 0;
    /* Room for focus rings and shadows inside the scroller. */
    padding: var(--space-2xs) var(--space-2xs) var(--space-md);
    list-style: none;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .strip li {
    scroll-snap-align: start;
  }

  .strip figure {
    display: grid;
    gap: var(--space-sm);
  }

  .strip__frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .strip__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strip__stand-in {
    display: grid;
    place-items: center;
    color: var(--accent-text);
  }

  .strip__stand-in svg {
    width: 44%;
    height: auto;
  }

  .strip figcaption {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    font-weight: 550;
  }
</style>
