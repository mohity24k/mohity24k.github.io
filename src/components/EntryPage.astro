---
/**
 * A plain page for one feed item: title, summary, outbound links, body.
 * Shared by project, post and publication routes so every card has somewhere
 * to go. Step 3 gives each kind its full layout.
 */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { isoDate, type FeedItem } from '../lib/feed';

interface Props {
  item: FeedItem;
  back: { href: string; label: string };
}

const { item, back } = Astro.props;
---

<Base title={item.title} world={item.world} description={item.summary}>
  <article class="wrap entry">
    <header class="entry__head">
      <h1>{item.title}</h1>
      <p class="entry__summary">{item.summary}</p>

      {
        (item.status || item.badge || item.dateText) && (
          <p class="entry__meta label">
            {[item.status, item.badge].filter(Boolean).join(' · ')}
            {item.dateText && (item.status || item.badge) && ' · '}
            {item.dateText && <time datetime={isoDate(item.date)}>{item.dateText}</time>}
          </p>
        )
      }

      {
        item.links.length > 0 && (
          <ul class="entry__links">
            {item.links.map(({ label, href }) => (
              <li>
                {href ? (
                  <a class="btn" href={href} target="_blank" rel="noopener">
                    <span>{label}</span>
                    <Icon name="external" />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                ) : (
                  <span class="soon">
                    {label}
                    <span aria-hidden="true">·</span>
                    coming soon
                  </span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <p class="entry__back ui">
      <a href={back.href}>{back.label}</a>
    </p>
  </article>
</Base>

<style>
  .entry {
    max-width: calc(var(--measure) + 2 * var(--page-gutter));
    margin-inline-start: max(var(--page-gutter), (100% - var(--page-max)) / 2);
    padding-block-start: var(--space-3xl);
  }

  .entry h1 {
    font-size: var(--step-4);
  }

  .entry__summary {
    margin-block-start: var(--space-md);
    color: var(--ink-soft);
    font-size: var(--step-1);
  }

  .entry__meta {
    margin-block-start: var(--space-md);
  }

  .entry__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .prose {
    margin-block-start: var(--space-2xl);
  }

  .prose :global(* + *) {
    margin-block-start: var(--space-md);
  }

  .prose :global(h2) {
    margin-block-start: var(--space-2xl);
    font-size: var(--step-2);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.25em;
  }

  .prose :global(li + li) {
    margin-block-start: var(--space-xs);
  }

  .entry__back {
    margin-block-start: var(--space-3xl);
  }
</style>
