---
/**
 * The contact form.
 *
 * With a Web3Forms key in src/data/site.ts the message is sent through
 * Web3Forms, and success or failure is shown here without leaving the page.
 * Without JavaScript the form still posts to Web3Forms directly.
 *
 * With no key yet, the same form opens the visitor's email app with the
 * message filled in (a mailto: link), so there is never a dead form.
 *
 * Spam: a hidden "botcheck" box that people never see and bots tick.
 */
import Icon from './Icon.astro';
import { site } from '../data/site';

const live = Boolean(site.web3formsKey);
const topics = ['Opportunity', 'Collaboration', 'Just saying hi'];
---

<form
  class="form"
  action={live ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`}
  method={live ? 'post' : 'get'}
  data-contact={live ? 'web3forms' : 'mailto'}
  data-email={site.email}
>
  {
    live && (
      <>
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="from_name" value={`${site.name}'s site`} />
        {/* Honeypot: hidden from people; a bot that ticks it is ignored. */}
        <input type="checkbox" name="botcheck" class="form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </>
    )
  }

  <div class="form__row">
    <div class="field">
      <label for="contact-name">Your name</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" />
    </div>
    <div class="field">
      <label for="contact-email">Your email</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" inputmode="email" />
    </div>
  </div>

  <fieldset class="field topics">
    <legend>What is it about?</legend>
    <div class="topics__options">
      {
        topics.map((topic, i) => (
          <label class="topic">
            {/* In mailto mode the topic becomes the email's subject. */}
            <input type="radio" name={live ? 'topic' : 'subject'} value={topic} checked={i === 0} />
            <span>{topic}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name={live ? 'message' : 'body'} rows="6" required maxlength="5000"></textarea>
  </div>

  <div class="form__foot">
    <button type="submit" class="btn form__send">
      <span data-send-label>{live ? 'Send message' : 'Write it in your email app'}</span>
      <Icon name={live ? 'arrow' : 'mail'} />
    </button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </div>

  <p class="form__fallback">
    Or email me directly: <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</form>

<script>
  function setUp(form: HTMLFormElement) {
    if (form.dataset.ready) return;
    form.dataset.ready = 'true';

    const mode = form.dataset.contact;
    const email = form.dataset.email ?? '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = form.querySelector<HTMLElement>('[data-send-label]')!;
    const idle = label.textContent ?? '';

    const say = (state: 'sending' | 'sent' | 'failed' | '', message: string) => {
      status.dataset.state = state;
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();

      // No key yet: hand the message to the visitor's email app.
      if (mode === 'mailto') {
        const subject = `${data.get('subject')}, from ${name}`;
        const body = `${data.get('body')}\n\n${name}\n${data.get('email')}`;
        const link = document.createElement('a');
        link.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        link.click();
        say('sent', `Your email app should have opened with the message filled in. If it did not, write to ${email}.`);
        return;
      }

      // A ticked honeypot means a bot: answer as if it worked, send nothing.
      if (data.get('botcheck')) {
        say('sent', 'Thanks. Your message is on its way.');
        form.reset();
        return;
      }

      button.disabled = true;
      label.textContent = 'Sending';
      say('sending', 'Sending your message.');

      try {
        data.set('subject', `${data.get('topic')}: message from ${name} via the site`);
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(data)),
        });
        const result = (await response.json()) as { success?: boolean };
        if (!response.ok || !result.success) throw new Error('Web3Forms did not accept the message');

        say('sent', `Thanks, ${name}. Your message is on its way and I will reply by email.`);
        form.reset();
      } catch {
        say('failed', `That did not send. Check your connection and try again, or email ${email} directly. Your message is still in the form.`);
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLFormElement>('form[data-contact]').forEach(setUp);
  });
</script>

<style>
  .form {
    display: grid;
    gap: var(--space-lg);
  }

  .form__trap {
    display: none;
  }

  .form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-lg) var(--grid-gap);
  }

  .field {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field > label,
  .field > legend {
    padding: 0;
    font-weight: 600;
  }

  .field input[type='text'],
  .field input[type='email'],
  .field textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-md);
    background-color: var(--bg-raised);
    transition: border-color var(--dur-fast) var(--ease-world);
  }

  .field textarea {
    min-height: 9rem;
    line-height: 1.5;
    resize: vertical;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--ink);
  }

  /* Only after the visitor has tried: never shout at an empty form. */
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: var(--error);
    box-shadow: 0 0 0 1px var(--error);
  }

  .topics__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
  }

  .topic {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-md);
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-pill);
    background-color: var(--bg-raised);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 550;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-world),
      color var(--dur-fast) var(--ease-world),
      border-color var(--dur-fast) var(--ease-world);
  }

  /* The radio itself fills the chip invisibly, so it stays keyboard- and
     screen-reader-operable while the chip carries the look. */
  .topic input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .topic:hover {
    border-color: var(--ink);
  }

  .topic:has(input:checked) {
    border-color: var(--ink);
    background-color: var(--ink);
    color: var(--bg);
  }

  .topic:has(input:focus-visible) {
    outline: var(--focus-w) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
  }

  .form__send {
    min-height: 3.25rem;
    padding-inline: var(--space-lg);
    font-size: var(--step-0);
  }

  .form__send:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form__status {
    flex: 1 1 16rem;
    min-height: 1.5em;
    font-weight: 550;
  }

  .form__status[data-state='sent'] {
    color: var(--success);
  }

  .form__status[data-state='failed'] {
    color: var(--error);
  }

  .form__fallback {
    color: var(--ink-soft);
  }
</style>
