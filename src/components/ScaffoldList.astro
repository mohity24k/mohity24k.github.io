---
/**
 * Step 1 scaffold only: a plain list of content entries, each painted in its
 * own world. Proves the collections → page → theme pipeline end to end.
 * Replaced by the real cards in step 2.
 */
import type { World } from '../data/taxonomy';

export interface ScaffoldItem {
  kind: string;
  title: string;
  summary: string;
  world: World;
  tags: readonly string[];
}

interface Props {
  items: ScaffoldItem[];
  note: string;
}

const { items, note } = Astro.props;
---

<ul class="scaffold">
  {
    items.map((item) => (
      <li class="scaffold__item world-surface" data-world={item.world}>
        <h2>{item.title}</h2>
        <p>{item.summary}</p>
        <p class="label">
          {item.kind} · {item.tags.join(' · ')}
        </p>
      </li>
    ))
  }
</ul>
<p class="ui scaffold__note">{note}</p>

<style>
  .scaffold {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min), 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scaffold__item {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--card-shadow);
  }

  .scaffold__item h2 {
    font-size: var(--step-2);
  }

  .scaffold__item p:not(.label) {
    color: var(--ink-soft);
  }

  .scaffold__note {
    margin-block-start: var(--space-xl);
    color: var(--ink-soft);
  }
</style>
