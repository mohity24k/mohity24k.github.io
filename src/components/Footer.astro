---
/**
 * Shared footer: identical structure on every page.
 */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { WORLDS } from '../data/taxonomy';

const year = new Date().getFullYear();
const socials = site.socials.filter((s) => s.url || !s.hideIfMissing);
const sections = [WORLDS.lab, WORLDS.studio, WORLDS.journal, { label: 'About', path: '/about/' }];
---

<footer class="footer ui">
  <div class="wrap footer__grid">
    <div class="footer__about">
      <p class="footer__name">{site.name}</p>
      <p class="footer__tagline">{site.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="footer__list">
        {
          sections.map(({ label, path }) => (
            <li>
              <a href={path}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="footer__list" aria-label="Elsewhere">
      {
        socials.map(({ label, url }) => (
          <li>
            {url ? (
              <a href={url} target="_blank" rel="noopener me">
                <span>{label}</span>
                <Icon name="external" size={14} />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ) : (
              <span class="footer__pending">
                <span>{label}</span>
                <span class="soon">Coming soon</span>
              </span>
            )}
          </li>
        ))
      }
      <li>
        <a href={`mailto:${site.email}`}>
          <span>{site.email}</span>
        </a>
      </li>
    </ul>

    <a class="btn btn--quiet footer__cta" href="/about/#contact">
      <span>Get in touch</span>
      <Icon name="arrow" />
    </a>
  </div>

  <div class="wrap footer__base">
    <p>© {year} {site.name}</p>
    <a href="/rss.xml">
      <Icon name="rss" size={14} />
      <span>Journal RSS</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-4xl);
    border-block-start: var(--border-w) solid var(--line);
    color: var(--ink-soft);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.4fr) auto;
    align-items: start;
    gap: var(--space-xl) var(--grid-gap);
    padding-block: var(--space-2xl);
  }

  .footer__name {
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .footer__tagline {
    margin-block-start: var(--space-xs);
    max-width: 32ch;
    line-height: 1.5;
  }

  .footer__list {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__list a,
  .footer__pending {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2rem;
  }

  .footer__list a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }

  .footer__list a:hover {
    text-decoration-color: currentColor;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-md);
    border-block-start: var(--border-w) solid var(--line);
    font-size: var(--step--2);
  }

  .footer__base a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2rem;
    color: inherit;
  }

  @media (max-width: 60rem) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__about {
      grid-column: 1 / -1;
    }

    .footer__cta {
      justify-self: start;
    }
  }

  @media (max-width: 30rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
