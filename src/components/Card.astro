---
/**
 * The card. One anatomy for every item in every world:
 *   cover · status and platform · title · summary · up to two metrics ·
 *   tags · date · outbound links
 * Its look comes entirely from the tokens of its own `data-world`, which is
 * why a Lab card, a Studio card and a Journal card can sit side by side.
 *
 * The whole card is one click target (the title link); tags and outbound
 * links sit above it and stay separately clickable.
 */
import { Image } from 'astro:assets';
import CoverArt from './CoverArt.astro';
import Icon from './Icon.astro';
import { TAGS } from '../data/taxonomy';
import { isoDate, type FeedItem } from '../lib/feed';

interface Props {
  item: FeedItem;
  /** `feature` is the larger card used in "Selected work". */
  size?: 'feature' | 'standard';
  heading?: 'h2' | 'h3';
}

const { item, size = 'standard', heading: Heading = 'h3' } = Astro.props;
const metrics = item.metrics.slice(0, 2);
---

<article class="card" data-world={item.world} data-size={size}>
  <div class="card__media">
    {
      item.cover ? (
        <Image
          src={item.cover}
          alt={item.coverAlt}
          widths={[360, 540, 720]}
          sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw"
        />
      ) : (
        <CoverArt motif={item.art} seed={item.key} text={item.artText} />
      )
    }
    {
      (item.status || item.badge) && (
        <p class="card__flags ui">
          {item.status && <span class="flag flag--status">{item.status}</span>}
          {item.badge && <span class="flag">{item.badge}</span>}
        </p>
      )
    }
  </div>

  <div class="card__body">
    <Heading class="card__title">
      <a href={item.href}>{item.title}</a>
    </Heading>
    <p class="card__summary">{item.summary}</p>

    {
      metrics.length > 0 && (
        <dl class="card__metrics">
          {metrics.map((metric) => (
            <div>
              <dt class="label">{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="card__foot">
      <ul class="card__tags label" aria-label="Tags">
        {
          item.tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`}>{TAGS[tag]}</a>
            </li>
          ))
        }
      </ul>
      {
        item.dateText && (
          <time class="label" datetime={isoDate(item.date)}>
            {item.dateText}
          </time>
        )
      }
    </div>

    {
      item.links.length > 0 && (
        <ul class="card__links ui">
          {item.links.map(({ label, href }) => (
            <li>
              {href ? (
                <a href={href} target="_blank" rel="noopener">
                  <span>{label}</span>
                  <Icon name="external" size={14} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              ) : (
                <span class="soon">
                  {label}
                  <span class="soon__sep" aria-hidden="true">
                    ·
                  </span>
                  coming soon
                </span>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--bg-raised);
    box-shadow: var(--card-shadow);
    transition:
      translate var(--dur-world) var(--ease-world),
      box-shadow var(--dur-world) var(--ease-world),
      border-color var(--dur-world) var(--ease-world);
  }

  .card:hover {
    translate: 0 -3px;
    border-color: var(--line-strong);
    box-shadow: var(--card-shadow-hover);
  }

  /* Keyboard focus lands on the title link; show it around the whole card. */
  .card:has(.card__title a:focus-visible) {
    outline: var(--focus-w) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card__media {
    position: relative;
    border-block-end: var(--border-w) solid var(--line);
  }

  .card__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .card__flags {
    position: absolute;
    inset-block-start: var(--space-sm);
    inset-inline-start: var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .flag {
    padding: 0.2rem 0.55rem;
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-pill);
    background-color: var(--bg-raised);
    color: var(--ink);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .flag--status {
    border-color: var(--accent);
    background-color: var(--accent);
    color: var(--accent-ink);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .card__title {
    font-size: var(--step-1);
  }

  .card[data-size='feature'] .card__title {
    font-size: var(--step-2);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the card. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__summary {
    color: var(--ink-soft);
    font-size: 0.95em;
    line-height: 1.5;
  }

  .card__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding-block-start: var(--space-sm);
    border-block-start: var(--border-w) solid var(--line);
  }

  /* Value above its label; the label still comes first for screen readers. */
  .card__metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-3xs);
  }

  .card__metrics dd {
    margin: 0;
    color: var(--accent-text);
    font-family: var(--font-data);
    font-stretch: var(--data-stretch);
    font-size: var(--step-2);
    font-style: normal;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card__tags li + li::before {
    content: '·';
    margin-inline: 0.5em;
  }

  .card__tags a,
  .card__links a {
    position: relative;
    z-index: 2;
  }

  .card__tags a {
    color: inherit;
    text-decoration-color: transparent;
  }

  .card__tags a:hover {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: var(--space-sm) 0 0;
    border-block-start: var(--border-w) solid var(--line);
    list-style: none;
  }

  .card__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 1.75rem;
    font-weight: 600;
  }

  .soon__sep {
    opacity: 0.6;
  }
</style>
