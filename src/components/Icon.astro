---
/**
 * The site's icon set: authored 24px line icons, one stroke weight.
 * Decorative by default (aria-hidden); the surrounding control carries the label.
 */
const ICONS = {
  download: 'M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14',
  external: 'M8 16 16.5 7.5M9.5 7.5h7v7',
  arrow: 'M5 12h14m0 0-5-5m5 5-5 5',
  mail: 'M4 6.5h16v11H4zM4 7l8 6.5L20 7',
  back: 'M19 12H5m0 0 5-5m-5 5 5 5',
  prev: 'M14.5 5.5 8 12l6.5 6.5',
  next: 'M9.5 5.5 16 12l-6.5 6.5',
  close: 'M6.5 6.5l11 11M17.5 6.5l-11 11',
  play: 'M8.5 6v12l9.5-6z',
  rss: 'M5.5 5.5a13 13 0 0 1 13 13M5.5 11.5a7 7 0 0 1 7 7M6 18h.01',
} as const;

interface Props {
  name: keyof typeof ICONS;
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={ICONS[name]}></path>
</svg>
